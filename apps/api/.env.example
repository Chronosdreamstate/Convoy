# =============================================================================
# CONVOY API — Environment Variables
# Copy to .env and fill in real values before running.
# =============================================================================

NODE_ENV=development
PORT=3000

# PostgreSQL (with PostGIS extension)
# Local dev: use docker-compose.yml (runs on localhost:5432)
# Production: use your cloud DB URL (Supabase, Neon, RDS, etc.)
DATABASE_URL=postgresql://convoy:convoy@localhost:5432/convoy

# Redis 7
# Local dev: use docker-compose.yml (runs on localhost:6379)
# Production: use Upstash, Redis Cloud, etc.
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be changed before deploying to production (app refuses to start with defaults)
JWT_SECRET=change-me-in-production-minimum-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081

# Mapbox — https://account.mapbox.com/access-tokens/
# Required for route calculation, geocoding, and drive summary cards. The
# placeholder value makes the app refuse to start in production.
MAPBOX_API_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# Agora RTC — https://console.agora.io/
# Required for PTT (push-to-talk) audio channels. Empty => the app refuses to
# start in production.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# SMS — delivers the phone sign-in OTP. Required in production: with
# SMS_PROVIDER=none the app refuses to start (the OTP would be generated but
# never delivered). Twilio is the built-in provider; see apps/api/src/auth/sms.ts
# to swap it. Get credentials at https://console.twilio.com/
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Object storage for uploaded avatars/photos/audio.
#   local (default): writes to UPLOADS_DIR. Fine for a single instance with a
#     persistent volume; on ephemeral/multi-instance hosts uploads are lost on
#     restart — use s3 there.
#   s3: any S3-compatible service. Set S3_ENDPOINT for non-AWS providers, e.g.
#     Cloudflare R2 (https://<acct>.r2.cloudflarestorage.com), DigitalOcean
#     Spaces, Supabase Storage, or MinIO. In production, STORAGE_PROVIDER=s3
#     requires S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY or the app
#     refuses to start.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Firebase — https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your-firebase-project-id

# Nominatim contact email (required by OpenStreetMap usage policy)
NOMINATIM_CONTACT_EMAIL=your-email@example.com

# Google Sign-In — comma-separated OAuth client IDs accepted as token audience
# (iOS + Android + web IDs from https://console.cloud.google.com/apis/credentials).
# Unset: POST /auth/social with provider=google returns 503 PROVIDER_NOT_CONFIGURED.
GOOGLE_CLIENT_IDS=

# Apple Sign-In — comma-separated client IDs accepted as the `aud` claim of
# Apple identity tokens: the iOS app bundle ID (app.convoy.mobile) plus the
# Services ID if a web flow is added later.
# Unset: Apple tokens are still verified (signature/expiry/issuer) but WITHOUT
# audience pinning, and the server logs a warning at startup — acceptable for
# dev, MUST be set in production.
APPLE_CLIENT_IDS=app.convoy.mobile
